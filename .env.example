# StackChan_EX_Amigo
# Copy this file to ~/env/.env and adjust values for your environment.

# -------------------------------------------------------------------
# Assistant
# -------------------------------------------------------------------
ASSISTANT_NAME=スタックちゃん
ASSISTANT_PERSONA=

# -------------------------------------------------------------------
# AI
# -------------------------------------------------------------------
AI_PROVIDER=mlx
AI_CHAT_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
AI_SUMMARY_PROVIDER=mlx
AI_SUMMARY_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
AI_SEARCH_MODEL=gemini-3.1-flash-lite
AI_MAX_OUTPUT_TOKENS=1200
AI_RECENT_TURNS=5
AI_CHAT_TEMPERATURE=0.8
AI_SUMMARY_TEMPERATURE=0.3
AI_SEARCH_TEMPERATURE=0.3
SEARCH_KEYWORDS=調べて,しらべて,調査して,ちょうさして,サーチして,さーちして,ぐぐって,ググって
THINKING_STRIP_PATTERNS=Final Response:,Response:

# Gemini
GEMINI_API_KEY=

# OpenAI-compatible provider (use when AI_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Vision model (MLX VLM)
VLM_MODEL=lmstudio-community/Qwen3-VL-8B-Instruct-MLX-4bit

# -------------------------------------------------------------------
# StackChan / LAN
# -------------------------------------------------------------------
M5STACK_IP=192.168.1.49
M5STACK_PORT=80
M5STACK_URL=http://192.168.1.49:80
M5STACK_TIMEOUT=5

# -------------------------------------------------------------------
# STT / whisper.cpp
# -------------------------------------------------------------------
WHISPER_CLI=
WHISPER_MODEL=
WHISPER_MODEL_EN=
WHISPER_NO_SPEECH_THOLD=0.6
SPEECH_MIN_BYTES=10000
SPEECH_ALLOW_SHORT=はーい,いや,やだ,だめ,ねえ,見て,みて

# -------------------------------------------------------------------
# Voice
# -------------------------------------------------------------------
VOICE_SERVER_URL=http://127.0.0.1:5001
VOICE_REQUEST_TIMEOUT=30
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=2
KOKORO_VOICE_ENGLISH=af_sarah
VOICE_STORAGE_DIR=voice_store
PC_CACHE_AUDIO_DIR=voice_store/cache
STACK_SD_AUDIO_DIR=../Copy-to-SD/stack_sd_audio

# -------------------------------------------------------------------
# Memory / archive
# -------------------------------------------------------------------
MEMORY_DIR=memory
ARCHIVE_DIR=archive
SUMMARY_KEEP_DAYS=14

# -------------------------------------------------------------------
# Vision
# -------------------------------------------------------------------
VISION_TRANSIENT_KEYWORDS=見て,みて,これ見て,みてみて,見てください,みてください,look at this,see this,can you see this
VISION_ARCHIVE_KEYWORDS=資料用に撮って,しりょうようにとって,撮影して,さつえいして,写真撮って,しゃしんとって,写真を撮って,しゃしんをとって,take a picture,take a photo,photo please,capture this
VISION_ARCHIVE_DIR=~/Desktop/stack_photo
VISION_DIR=/tmp/stackchan_vision
AI_VISION_TRANSIENT_MARKER=[[VISION_TRANSIENT_TRIGGER]]
AI_VISION_ARCHIVE_MARKER=[[VISION_ARCHIVE_TRIGGER]]
AI_VISION_TRIGGER_ENDPOINT=vision_ai_trigger

# -------------------------------------------------------------------
# Weather (optional)
# Leave blank to disable weather features.
# -------------------------------------------------------------------
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_KEYWORDS_TODAY=今日の天気,きょうのてんき
WEATHER_KEYWORDS_TOMORROW=明日の天気,あしたのてんき
WEATHER_MORNING_HOUR=7
WEATHER_MORNING_MINUTE=10
WEATHER_FORECAST_HOUR=17
WEATHER_FORECAST_MINUTE=0
WEATHER_CONFIRMED_HOUR=19
WEATHER_CONFIRMED_MINUTE=0

# -------------------------------------------------------------------
# Scheduler / notifications (optional)
# -------------------------------------------------------------------
SERVER_PORT=5050
ANNOUNCEMENTS_FILE=json/announcements.json
RENDER_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# LINE通知
RENDER_URL=
FAMILY1_LINE_USER_ID=

# -------------------------------------------------------------------
# Songs (optional)
# SONG_MAP format example: きらきら星|きらきらぼし:twinkle
# -------------------------------------------------------------------
SONG_TRIGGER=歌って,うたって,歌ってください
SONG_MAP=
